# =========================================
# Database
# =========================================
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/sales_management"

# =========================================
# NextAuth
# =========================================
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# =========================================
# Zoom API
# https://marketplace.zoom.us/ でアプリ作成
# =========================================
ZOOM_ACCOUNT_ID="your_zoom_account_id"
ZOOM_CLIENT_ID="your_zoom_client_id"
ZOOM_CLIENT_SECRET="your_zoom_client_secret"
ZOOM_WEBHOOK_SECRET_TOKEN="your_zoom_webhook_secret"

# =========================================
# Google Calendar API
# https://console.cloud.google.com/ で設定
# =========================================
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/integrations/google/callback"
GOOGLE_CALENDAR_ID="primary"

# =========================================
# Chatwork API
# https://www.chatwork.com/service/packages/chatwork/subpackages/api/
# =========================================
CHATWORK_API_TOKEN="your_chatwork_api_token"
# 通知を送るルームID（管理者チャンネル）
CHATWORK_ROOM_ID="your_chatwork_room_id"

# =========================================
# 商品仕入れ自動化 - アクセス制御
# この機能を使うための専用パスワード（未設定の場合はパスワード不要）
# =========================================
SOURCING_PASSWORD="your_sourcing_password_here"

# =========================================
# 商品仕入れ自動化 - 楽天API
# https://webservice.rakuten.co.jp/ でアプリ登録
# =========================================
RAKUTEN_APP_ID="your_rakuten_app_id"

# =========================================
# 商品仕入れ自動化 - Amazon PA-API v5
# https://affiliate.amazon.co.jp/ で登録
# =========================================
AMAZON_PA_API_ACCESS_KEY="your_amazon_pa_api_access_key"
AMAZON_PA_API_SECRET_KEY="your_amazon_pa_api_secret_key"
AMAZON_PA_API_PARTNER_TAG="your_amazon_partner_tag"

# =========================================
# 商品仕入れ自動化 - X (Twitter) API
# https://developer.twitter.com/ で登録
# =========================================
TWITTER_BEARER_TOKEN="your_twitter_bearer_token"

# =========================================
# 商品仕入れ自動化 - Google Custom Search
# TV紹介商品検索用（オプション）
# =========================================
GOOGLE_CUSTOM_SEARCH_API_KEY="your_google_custom_search_api_key"
GOOGLE_CUSTOM_SEARCH_ENGINE_ID="your_google_custom_search_engine_id"

# =========================================
# 商品仕入れ自動化 - LINE Notify
# https://notify-bot.line.me/ で登録
# =========================================
LINE_NOTIFY_TOKEN="your_line_notify_token"

# =========================================
# Cronジョブ認証
# =========================================
CRON_SECRET="your_cron_secret_here"
