# =========================================
# Database
# =========================================
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/sales_management"

# =========================================
# NextAuth
# =========================================
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# =========================================
# Zoom API
# https://marketplace.zoom.us/ でアプリ作成
# =========================================
ZOOM_ACCOUNT_ID="your_zoom_account_id"
ZOOM_CLIENT_ID="your_zoom_client_id"
ZOOM_CLIENT_SECRET="your_zoom_client_secret"
ZOOM_WEBHOOK_SECRET_TOKEN="your_zoom_webhook_secret"

# =========================================
# Google Calendar API
# https://console.cloud.google.com/ で設定
# =========================================
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/integrations/google/callback"
GOOGLE_CALENDAR_ID="primary"

# =========================================
# Chatwork API
# https://www.chatwork.com/service/packages/chatwork/subpackages/api/
# =========================================
CHATWORK_API_TOKEN="your_chatwork_api_token"
# 通知を送るルームID（管理者チャンネル）
CHATWORK_ROOM_ID="your_chatwork_room_id"

# =========================================
# 在庫検索 API
# =========================================
# 楽天市場 アプリID (https://webservice.rakuten.co.jp/ で取得)
RAKUTEN_APP_ID="your_rakuten_app_id"

# Yahoo!ショッピング アプリID (https://developer.yahoo.co.jp/ で取得)
YAHOO_APP_ID="your_yahoo_app_id"
