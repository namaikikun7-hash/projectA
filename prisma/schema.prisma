generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================================
// 認証関連（NextAuth Prisma Adapter）
// =========================================
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// =========================================
// ユーザー（営業マン・管理者）
// =========================================
model User {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  emailVerified  DateTime?
  password       String?   // bcrypt ハッシュ
  role           Role      @default(STAFF)
  avatar         String?
  phone          String?
  zoomUserId     String?   // Zoom連携用
  googleRefreshToken String? @db.Text // Google Calendar連携用
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  meetings       Meeting[]   @relation("AssignedStaff")
  evaluations    Evaluation[]
  kpiTargets     KpiTarget[]

  @@index([email])
}

enum Role {
  ADMIN   // 管理者
  MANAGER // マネージャー
  STAFF   // 営業スタッフ
}

// =========================================
// 顧客
// =========================================
model Client {
  id          String   @id @default(cuid())
  name        String
  email       String?
  phone       String?
  company     String?
  source      LeadSource @default(UNKNOWN) // 流入元
  schoolType  String?  // 希望のオンラインスクール種別
  budget      Int?     // 予算（円）
  ageGroup    String?  // 年齢層
  occupation  String?  // 職業
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  meetings    Meeting[]

  @@index([email])
}

enum LeadSource {
  INSTAGRAM
  TWITTER
  YOUTUBE
  GOOGLE_AD
  REFERRAL
  LP
  UNKNOWN
}

// =========================================
// 商談
// =========================================
model Meeting {
  id               String        @id @default(cuid())
  clientId         String
  staffId          String
  scheduledAt      DateTime
  durationMinutes  Int           @default(60)
  zoomMeetingId    String?
  zoomJoinUrl      String?       @db.Text
  zoomRecordingUrl String?       @db.Text
  calendarEventId  String?
  status           MeetingStatus @default(SCHEDULED)
  result           MeetingResult?
  contractAmount   Int?          // 成約金額（円）
  notes            String?       @db.Text
  reminderSentAt   DateTime?     // リマインダー送信日時
  feedbackDueAt    DateTime?     // フィードバック提出期限
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  client   Client          @relation(fields: [clientId], references: [id])
  staff    User            @relation("AssignedStaff", fields: [staffId], references: [id])
  feedback MeetingFeedback?

  @@index([staffId])
  @@index([clientId])
  @@index([scheduledAt])
  @@index([status])
}

enum MeetingStatus {
  SCHEDULED   // 予定
  IN_PROGRESS // 実施中
  COMPLETED   // 完了
  CANCELLED   // キャンセル
  NO_SHOW     // 無断キャンセル
}

enum MeetingResult {
  CONTRACTED // 成約
  LOST       // 失注
  FOLLOW_UP  // 再商談・保留
  NO_SHOW    // 無断キャンセル
}

// =========================================
// 商談フィードバック（営業マンが入力）
// =========================================
model MeetingFeedback {
  id               String   @id @default(cuid())
  meetingId        String   @unique
  // 顧客の状態
  painPoints       String?  @db.Text // 課題・悩み
  budget           Int?     // ヒアリングした予算
  motivation       Int      // モチベーション 1-5
  decisionMaker    Boolean  @default(true) // 意思決定者か
  competitors      String?  // 他社検討状況
  // 商談評価
  objections       String?  @db.Text // 反論・懸念事項
  closingScore     Int      // クロージング評価 1-10
  selfScore        Int      // 自己評価 1-5
  nextAction       String?  @db.Text // 次のアクション
  followUpDate     DateTime? // フォローアップ予定日
  // メタ
  submittedAt      DateTime @default(now())
  updatedAt        DateTime @updatedAt

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
}

// =========================================
// 評価（月次集計）
// =========================================
model Evaluation {
  id                  String   @id @default(cuid())
  staffId             String
  period              String   // "2024-01" 形式
  // 商談数実績
  totalMeetings       Int      @default(0)
  completedMeetings   Int      @default(0)
  contracts           Int      @default(0)
  lost                Int      @default(0)
  followUps           Int      @default(0)
  noShows             Int      @default(0)
  // 金額実績
  totalContractAmount Int      @default(0)
  // 算出指標
  conversionRate      Float    @default(0) // 成約率 (%)
  feedbackSubmitRate  Float    @default(0) // フィードバック提出率 (%)
  avgClosingScore     Float    @default(0) // 平均クロージングスコア
  avgSelfScore        Float    @default(0) // 平均自己評価
  noShowRate          Float    @default(0) // 無断キャンセル率 (%)
  // 総合評価
  totalScore          Float    @default(0) // 100点満点
  grade               String?  // S / A / B / C / D
  managerComment      String?  @db.Text
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  staff User @relation(fields: [staffId], references: [id])

  @@unique([staffId, period])
  @@index([period])
}

// =========================================
// KPI目標設定
// =========================================
model KpiTarget {
  id                      String  @id @default(cuid())
  staffId                 String? // null = 全体目標
  period                  String  // "2024-01"
  targetMeetings          Int     @default(20)
  targetContracts         Int     @default(10)
  targetConversionRate    Float   @default(50.0)
  targetContractAmount    Int     @default(0)

  staff User? @relation(fields: [staffId], references: [id])

  @@unique([staffId, period])
}

// =========================================
// 通知ログ
// =========================================
model NotificationLog {
  id        String           @id @default(cuid())
  type      NotificationType
  target    String           // Chatwork room ID or user ID
  message   String           @db.Text
  status    String           @default("sent") // sent / failed
  relatedId String?          // meetingId etc.
  sentAt    DateTime         @default(now())
}

enum NotificationType {
  FEEDBACK_REMINDER    // フィードバック催促
  CONTRACT_ALERT       // 成約通知
  MEETING_REMINDER     // 商談前リマインダー
  DAILY_REPORT         // 日次レポート
  MONTHLY_EVALUATION   // 月次評価通知
  SOURCING_ALERT       // 商品仕入れアラート
}

// =========================================
// 商品仕入れ自動化
// =========================================

// トレンド商品（リサーチ結果）
model SourcingProduct {
  id              String              @id @default(cuid())
  name            String              // 商品名
  jan             String?             // JANコード
  asin            String?             // Amazon ASIN
  imageUrl        String?             @db.Text
  category        String?             // 商品カテゴリ
  officialUrl     String?             @db.Text // 公式サイトURL
  officialPrice   Int?                // 公式サイト価格（円）
  amazonPrice     Int?                // Amazon現在価格（円）
  amazonStock     AmazonStockStatus   @default(UNKNOWN) // Amazon在庫状況
  estimatedProfit Int?                // 推定利益（円）
  profitMargin    Float?              // 利益率（%）
  trendScore      Int                 @default(0) // トレンドスコア (0-100)
  status          SourcingStatus      @default(DETECTED) // ステータス
  notes           String?             @db.Text
  detectedAt      DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  trendSources    TrendSource[]       // トレンド検出元
  priceHistory    PriceHistory[]      // 価格推移
  purchaseOrders  PurchaseOrder[]     // 仕入れ注文
  amazonListings  AmazonListing[]     // Amazon出品

  @@index([asin])
  @@index([jan])
  @@index([status])
  @@index([trendScore])
  @@index([detectedAt])
}

// 仕入れステータス
enum SourcingStatus {
  DETECTED          // トレンド検出済み
  RESEARCHING       // リサーチ中
  PROFITABLE        // 利益見込みあり
  PURCHASING        // 仕入れ中
  IN_STOCK          // 在庫あり（仕入れ済み）
  LISTED            // Amazon出品中
  SOLD              // 販売完了
  SKIPPED           // スキップ（利益なし等）
  EXPIRED           // トレンド終了
}

// Amazon在庫ステータス
enum AmazonStockStatus {
  IN_STOCK          // 在庫あり
  LOW_STOCK         // 在庫わずか
  OUT_OF_STOCK      // 在庫切れ
  UNAVAILABLE       // 取り扱いなし
  UNKNOWN           // 不明
}

// トレンド検出元
model TrendSource {
  id              String          @id @default(cuid())
  productId       String
  sourceType      TrendSourceType // 検出元の種類
  sourceUrl       String?         @db.Text // ソースURL
  sourceTitle     String?         // ソースタイトル（TV番組名、ツイート内容等）
  mentionCount    Int             @default(1) // 言及数
  detectedAt      DateTime        @default(now())

  product         SourcingProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([sourceType])
}

// トレンド検出元の種類
enum TrendSourceType {
  RAKUTEN_RANKING   // 楽天ランキング
  TWITTER_BUZZ      // X(Twitter)バズ
  TV_FEATURE        // テレビ紹介
  DISCONTINUATION   // 生産終了・販売終了
  NEWS_ARTICLE      // ニュース記事
  MANUAL            // 手動登録
}

// 価格推移ログ
model PriceHistory {
  id              String          @id @default(cuid())
  productId       String
  amazonPrice     Int?            // Amazon価格
  officialPrice   Int?            // 公式サイト価格
  amazonStock     AmazonStockStatus @default(UNKNOWN)
  recordedAt      DateTime        @default(now())

  product         SourcingProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([recordedAt])
}

// 仕入れ注文
model PurchaseOrder {
  id              String              @id @default(cuid())
  productId       String
  purchaseSite    String              // 仕入先サイト名
  purchaseUrl     String?             @db.Text // 仕入先URL
  purchasePrice   Int                 // 仕入れ価格
  quantity        Int                 @default(1)
  totalCost       Int                 // 仕入れ合計額
  orderStatus     OrderStatus         @default(PENDING)
  orderNumber     String?             // 注文番号
  trackingNumber  String?             // 追跡番号
  estimatedArrival DateTime?          // 到着予定日
  orderedAt       DateTime?           // 注文日時
  arrivedAt       DateTime?           // 到着日時
  notes           String?             @db.Text
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  product         SourcingProduct     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([orderStatus])
}

// 仕入れ注文ステータス
enum OrderStatus {
  PENDING           // 注文前（候補）
  ORDERED           // 注文済み
  SHIPPED           // 発送済み
  DELIVERED         // 到着済み
  CANCELLED         // キャンセル
  RETURNED          // 返品
}

// Amazon出品
model AmazonListing {
  id              String              @id @default(cuid())
  productId       String
  asin            String?             // Amazon ASIN
  listingPrice    Int                 // 出品価格
  quantity        Int                 @default(1)
  listingStatus   ListingStatus       @default(DRAFT)
  soldQuantity    Int                 @default(0)
  totalRevenue    Int                 @default(0) // 売上合計
  listedAt        DateTime?           // 出品日時
  soldAt          DateTime?           // 販売完了日時
  notes           String?             @db.Text
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  product         SourcingProduct     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([listingStatus])
}

// 出品ステータス
enum ListingStatus {
  DRAFT             // 下書き
  ACTIVE            // 出品中
  SOLD              // 販売完了
  CANCELLED         // 出品取消
}
